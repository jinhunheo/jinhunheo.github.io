{
  "name": "jinhun-heo-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio of Jinhun Heo, built with Vite and deployed with Cloudflare cf.",
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "cf dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "images": "node scripts/images.ts",
    "import-media": "node scripts/import-media.ts",
    "build:staging": "cf build --mode staging",
    "build": "cf build",
    "check": "npm run typecheck && npm test && cf deploy --dry-run --mode staging",
    "deploy:staging": "cf deploy --mode staging",
    "deploy": "cf deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.21",
    "marked": "18.1.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
}
